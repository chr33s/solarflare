{
  "name": "@chr33s/solarflare",
  "version": "0.1.0",
  "description": "Cloudflare-optimized streaming SSR meta-framework. Publishes TypeScript sources; requires Node ≥24.12 (type-stripping) or tsx.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chr33s/solarflare"
  },
  "bin": {
    "solarflare": "./src/build.ts"
  },
  "files": [
    "src",
    "tsconfig.json",
    "!src/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/solarflare.d.ts",
      "import": "./src/worker.ts"
    },
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./tsconfig.json": "./tsconfig.json"
  },
  "scripts": {
    "check": "oxfmt --check && oxlint --type-aware --type-check",
    "examples:clean": "rm -rvf ./examples/*/.wrangler ./examples/*/.shopify ./examples/*/dist  ./examples/*/node_modules",
    "examples:install": "for dir in basic dsd minimal node shopify-app; do npm install --prefix ./examples/${dir} --silent; done && bun install --cwd=./examples/bun && cd examples/deno && deno install",
    "fix": "oxlint --type-aware --type-check --fix && oxfmt --write",
    "test": "WRANGLER_LOG=error; node --test src/*.test.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "lightningcss": "1.33.0",
    "picomatch": "4.0.7",
    "preact": "11.2.0",
    "preact-custom-element": "4.6.0",
    "preact-render-to-string": "6.8.3",
    "rolldown": "1.3.2",
    "tsx": "4.23.15",
    "turbo-stream": "3.2.1"
  },
  "devDependencies": {
    "@preact/signals-debug": "1.5.0",
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "playwright": "1.65.0",
    "typescript": "7.0.2",
    "wrangler": "4.161.0"
  },
  "optionalDependencies": {
    "ts-morph": "28.0.0"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
